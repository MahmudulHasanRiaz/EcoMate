# Landing app environment
#
# Browser calls use relative /api/* and are rewritten to this origin by
# next.config.ts.
PLATFORM_API_URL=http://localhost:4100/api

# Optional Cloudflare Turnstile site key. When omitted, the widget is not
# rendered (local development); production sets it together with the platform's
# TURNSTILE_SECRET_KEY.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Branding (until the platform exposes a public branding endpoint, the
# landing reads these from env — see lib/branding.ts). Logo must be an
# https URL or a same-origin path; anything else is ignored.
NEXT_PUBLIC_PLATFORM_NAME=EcoMate
NEXT_PUBLIC_LOGO_URL=

# Tenant base domain used by the /sign-in page to build tenant admin URLs
# (https://<slug>.<domain>/admin/sign-in).
NEXT_PUBLIC_PRIMARY_DOMAIN=ecomate.bd

# Fallback trial length (days) for the "Start a N-day trial" copy, used only
# when no public plan carries a trial. Normally the trial length comes from
# the live plan list (GET /public/plans) — see lib/plans.ts.
NEXT_PUBLIC_TRIAL_DAYS=
