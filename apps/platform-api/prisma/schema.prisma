// EcoMate SaaS platform control-plane schema.
// This database is separate from the tenant database (`ecomate`).
// Tenant data is never stored here; only the tenant registry, plans,
// subscriptions, invoices, payments, domains, usage and audit.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformUserRole {
  SUPERADMIN
  BILLING
  SUPPORT
  READONLY
}

enum PlatformUserStatus {
  ACTIVE
  DISABLED
}

enum TenantStatus {
  PENDING_VERIFICATION
  PROVISIONING
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  DELETED
}

enum TenantDomainType {
  SUBDOMAIN
  CUSTOM
}

enum TenantDomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  DISABLED
}

enum SignupStatus {
  PENDING_EMAIL
  VERIFIED
  EXPIRED
  CANCELLED
}

enum BillingInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

/// Feature classification (Boss's words, Features page 2026-11-21):
/// INITIAL = included in the base plan, ADD_ON = sold as a separate
/// add-on. Prisma enum values cannot contain hyphens, so the API maps
/// these to 'initial' / 'add-on' at the boundary.
enum FeatureKind {
  INITIAL
  ADD_ON
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentMethodType {
  BKASH
  NAGAD
  ROCKET
  BANK
  MANUAL
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum CouponDuration {
  ONCE
  FOREVER
  MONTHS
}

enum AuditActorType {
  PLATFORM
  TENANT
  SYSTEM
}

enum ProvisioningStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// How a lead can be reached. Lowercase values: the public lead form and
/// the console both use 'email' | 'phone' verbatim.
enum LeadContactType {
  email
  phone
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  DEMO_SCHEDULED
  WON
  LOST
  CLOSED
}

/// Tenant plan-change request lifecycle (Subscription hub): PENDING until
/// an operator applies it (via TenantsService.changePlan) or rejects it.
enum PlanChangeRequestStatus {
  PENDING
  APPLIED
  REJECTED
}

/// Where a grant of emails came from (EmailBalanceLot.source).
enum EmailLotSource {
  FREE_GRANT
  TOPUP
  ADJUSTMENT
}

/// Kind of an EmailBalanceLedger row (append-only audit trail).
enum EmailLedgerKind {
  GRANT
  SEND
  EXPIRE
  ADJUSTMENT
}

/// Lifecycle of an EmailTopUp purchase. PENDING until its invoice is
/// fully paid (approveProof credits the lot and flips it to PAID);
/// VOID only for an unpaid top-up whose invoice was voided.
enum EmailTopUpStatus {
  PENDING
  PAID
  VOID
}

model PlatformUser {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  role         PlatformUserRole   @default(READONLY)
  status       PlatformUserStatus @default(ACTIVE)
  /// TOTP secret, AES-256-GCM encrypted with APP_ENCRYPTION_KEY (enc:v1:
  /// prefix). Null until MFA is set up; inert until mfaEnabledAt is set.
  mfaSecret    String?
  /// Secret being enrolled, encrypted like mfaSecret. Only moved to
  /// mfaSecret once the user proves it with a valid code, so re-enrolling
  /// never locks the user out of the still-working old secret.
  mfaPendingSecret String?
  /// When MFA was enabled. Null = MFA not active (even if a secret exists).
  mfaEnabledAt DateTime?
  /// SHA-256 hashes of single-use recovery codes; a used code is removed.
  mfaRecoveryCodes String[]       @default([])
  /// Consecutive failed logins; reset on success. Drives progressive lockout.
  failedLoginCount Int             @default(0)
  /// Account is locked until this instant (progressive lockout, Phase 8).
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  refreshTokens  PlatformRefreshToken[]
  auditLogs      AuditLog[]
  impersonations ImpersonationSession[]
  invitesCreated PlatformUserInvite[]
  mediaUploads   MediaAsset[]          @relation("MediaUploadedBy")
  /// Leads assigned to this operator (Batch 2, item 12).
  assignedLeads  Lead[]                @relation("LeadAssignedTo")

  @@index([role, status])
}

model PlatformUserInvite {
  id          String           @id @default(uuid())
  email       String
  name        String
  role        PlatformUserRole @default(READONLY)
  tokenHash   String           @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdBy   PlatformUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())

  @@index([email, expiresAt])
}

model PlatformRefreshToken {
  id        String       @id @default(uuid())
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  /// Rotation family: one login mints a family; every refresh keeps it.
  /// A replayed (already-rotated) token revokes its whole family.
  familyId  String       @default(uuid())
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime     @default(now())
  /// Device/browser the session logged in from (User-Agent, capped at 512
  /// chars when recorded). Null for tokens minted before session metadata.
  userAgent  String?
  /// IP address the session logged in from (or last refreshed from).
  ipAddress  String?
  /// Last login or refresh in this token's rotation family. Access-token
  /// use does not touch the DB, so this is login/refresh activity, not
  /// the last API call.
  lastUsedAt DateTime?

  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([userId, lastUsedAt])
}

model Tenant {
  id                 String       @id @default(uuid())
  slug               String       @unique
  name               String
  status             TenantStatus @default(PENDING_VERIFICATION)
  ownerEmail         String
  ownerPhone         String?
  planVersionId      String?
  planVersion        PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt        DateTime?
  suspendedAt        DateTime?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  domains           TenantDomain[]
  subscription      Subscription?
  invoices          Invoice[]
  reminders         InvoiceReminder[]
  paymentProofs     PaymentProof[]
  payments          Payment[]
  creditNotes       CreditNote[]
  couponRedemptions CouponRedemption[]
  usage             UsageDaily[]
  limitOverrides    TenantLimitOverride[]
  pricingOverrides  TenantPricingOverride[]
  purchases         TenantPurchase[]
  blockingOverride  TenantBlockingOverride?
  auditLogs         AuditLog[]
  impersonations    ImpersonationSession[]
  provisioningJobs  ProvisioningJob[]
  convertedFromLeads Lead[] @relation("LeadConvertedTenant")
  emailLots         EmailBalanceLot[]
  emailLedger       EmailBalanceLedger[]
  emailTopUps       EmailTopUp[]
  emailAccount      TenantEmailAccount?
  planChangeRequests PlanChangeRequest[]

  @@index([status, createdAt])
  @@index([status, graceEndsAt])
  @@index([ownerEmail])
  @@index([planVersionId])
}

model TenantDomain {
  id                String             @id @default(uuid())
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  host              String             @unique
  type              TenantDomainType   @default(SUBDOMAIN)
  baseDomain        String?
  isPrimary         Boolean            @default(false)
  verificationToken String?
  status            TenantDomainStatus @default(PENDING)
  tlsStatus         String?
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tenantId, isPrimary])
  @@index([status])
}

/// Public signup request, before the tenant/provisioning rows exist.
/// Email verification proves ownership of the owner address; the raw token is
/// only ever sent by email, and only its SHA-256 hash is stored here.
model SignupRequest {
  id                    String       @id @default(uuid())
  tenantName            String
  slug                  String
  ownerEmail            String
  ownerPhone            String?
  passwordHash          String
  status                SignupStatus @default(PENDING_EMAIL)
  verificationTokenHash String?      @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([slug, status])
  @@index([ownerEmail, status])
  @@index([status, createdAt])
}

model Feature {
  key          String      @id
  name         String
  description  String?
  category     String
  dependencies String[]    @default([])
  unit         String?
  isActive     Boolean     @default(true)
  sortOrder    Int         @default(0)
  /// Classification for the console Features page (Boss's words):
  /// INITIAL = in the base plan, ADD_ON = sold separately. The API
  /// exposes 'initial' / 'add-on'.
  kind         FeatureKind @default(INITIAL)
  /// EN-only scope text for the i-button: what the feature covers.
  scope        String?
  /// EN-only text for the i-button: what a tenant WITHOUT the feature
  /// cannot see or do.
  withoutAccess String?
  /// The AddOn row selling this feature when kind = ADD_ON (null for
  /// initial features and for add-on features not yet converted).
  addOnId      String?
  addOn        AddOn?      @relation(fields: [addOnId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([category, sortOrder])
  @@index([kind])
}

model Plan {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  isPublic    Boolean  @default(true)
  isFree      Boolean  @default(false)
  sortOrder   Int      @default(0)
  badge       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions PlanVersion[]

  planChangeRequests PlanChangeRequest[]

  @@index([isActive, isPublic, sortOrder])
}

model PlanVersion {
  id            String          @id @default(uuid())
  planId        String
  plan          Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  version       Int
  price         Decimal         @db.Decimal(12, 2)
  currency      String          @default("BDT")
  interval      BillingInterval @default(MONTHLY)
  intervalDays  Int?
  trialDays     Int             @default(14)
  features      String[]        @default([])
  limits        Json            @default("{}")
  /// Structured pricing document (pricing engine §3). Validated by DTOs;
  /// `price` mirrors pricing.baseFee.amount (kept in sync by PlansService
  /// on write). `{}` = legacy version, backfilled by migration
  /// 20261118155700_pricing_engine_backfill.
  pricing       Json            @default("{}")
  graceDays     Int             @default(7)
  effectiveFrom DateTime        @default(now())
  archivedAt    DateTime?
  /// The signup default (Phase 8, D3): provisioning prefers the isDefault
  /// version over newest-wins. At most one version may be the default —
  /// enforced by the PARTIAL unique index in migration
  /// 20261116223521_phase8_stage0_platform_security (Prisma has no
  /// partial-index support), not by a schema attribute.
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenants       Tenant[]
  subscriptions Subscription[]
  pendingSubscriptions Subscription[] @relation("PendingPlanVersion")
  planChangeRequests PlanChangeRequest[]

  @@unique([planId, version])
  @@index([planId, effectiveFrom])
  /// GIN on the features array: the Features page detail view asks
  /// "which plan versions include key X" (array-contains). A b-tree
  /// cannot serve that; GIN can.
  @@index([features], type: Gin)
}

/// A tenant's request to move to another (public) plan, decided by an
/// operator from the console Billing → Plan requests tab. targetPlanId
/// is what the tenant asked for (plans are addressed by plan id — the
/// public catalogue exposes no version id); targetPlanVersionId is the
/// latest non-archived version resolved at request time, and apply()
/// changes the tenant to exactly that version. Only one PENDING request
/// per tenant may exist (enforced in the service, not by a partial
/// unique index — Prisma has no partial-index support).
///
/// decidedAt doubles as the apply claim: apply() stamps decidedBy/
/// decidedAt while the status is still PENDING (updateMany where
/// status=PENDING AND decidedAt IS NULL), so a second operator's claim
/// finds decidedAt set and gets a 409 instead of double-applying. If
/// changePlan throws, the claim is rolled back to NULL and the row is a
/// clean PENDING again.
model PlanChangeRequest {
  id                  String                  @id @default(uuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetPlanId        String
  targetPlan          Plan                    @relation(fields: [targetPlanId], references: [id])
  targetPlanVersionId String
  targetPlanVersion   PlanVersion             @relation(fields: [targetPlanVersionId], references: [id])
  status              PlanChangeRequestStatus @default(PENDING)
  note                String?
  rejectionReason     String?
  /// Add-on ids the tenant chose to KEEP in the conversion review
  /// (trial-end design 2026-11-22). Prisma has no nullable list
  /// (`String[]?` is invalid, P1012), so the no-choice state is
  /// carried by addOnChoiceMade, not by NULL: false = the tenant made
  /// no add-on choice (plain plan change, or a request filed before
  /// the review step existed) — apply() leaves trial add-ons
  /// untouched. true + [] = the tenant chose to keep NONE — apply()
  /// ends all trial add-ons. apply() confirms the kept trial add-ons
  /// and ends the dropped ones; ids that are not attached trial
  /// add-ons are ignored. Read by id/tenant only — no index.
  requestedAddOnIds String[] @default([])
  /// True when the tenant made an explicit add-on choice in the
  /// conversion review — including "keep none" (an empty
  /// requestedAddOnIds WITH this flag set). False = no choice was
  /// made; requestedAddOnIds is then an empty list with no meaning.
  addOnChoiceMade   Boolean  @default(false)
  /// Tenant user id (backend JWT `userId`) that filed the request.
  requestedBy         String?
  /// Platform user id that decided the request.
  decidedBy           String?
  decidedAt           DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([tenantId, status])
  @@index([status, createdAt])
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planVersionId        String
  planVersion          PlanVersion        @relation(fields: [planVersionId], references: [id])
  status               SubscriptionStatus @default(TRIAL)
  startedAt            DateTime           @default(now())
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEndsAt          DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  endedAt              DateTime?
  pendingPlanVersionId String?
  pendingPlanVersion   PlanVersion?       @relation("PendingPlanVersion", fields: [pendingPlanVersionId], references: [id])
  pendingPlanEffectiveAt DateTime?
  entitlementsSnapshot Json               @default("{}")
  /// Free billing periods remaining (pricing.freeMonths, §4.6). Set from
  /// the version's freeMonths at provisioning; consumed by the renewal
  /// job (one free period per renewal, no invoice). Survives plan changes.
  freePeriodsRemaining Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  invoices  Invoice[]
  addOns    SubscriptionAddOn[]
  purchases TenantPurchase[]

  @@index([status, currentPeriodEnd])
  @@index([status, trialEndsAt])
  @@index([cancelAtPeriodEnd, currentPeriodEnd])
  @@index([planVersionId, status])
}

model AddOn {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  currency    String          @default("BDT")
  interval    BillingInterval @default(MONTHLY)
  features    String[]        @default([])
  limits      Json            @default("{}")
  isActive    Boolean         @default(true)
  /// Public add-ons are visible to tenants (future self-service); private
  /// ones are console-only. Default true (existing add-ons stay visible).
  isPublic    Boolean         @default(true)
  sortOrder   Int             @default(0)
  /// Optional metered rates for the add-on, same shape as
  /// PlanVersion.pricing.metering (null = fixed price only).
  metering    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subscriptions SubscriptionAddOn[]
  /// Features sold through this add-on (Feature.addOnId). Named
  /// `linkedFeatures` because `features` is already the String[] of
  /// feature keys this add-on grants.
  linkedFeatures Feature[]
}

model SubscriptionAddOn {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addOnId        String
  addOn          AddOn        @relation(fields: [addOnId], references: [id], onDelete: Restrict)
  startedAt      DateTime     @default(now())
  endedAt        DateTime?
  /// Trial-end design (2026-11-22): true when the row was attached by
  /// the trial attach (provisioning), never by an operator or a
  /// conversion. A trial-granted row is NEVER billed until confirmed:
  /// resolveForSubscription excludes trialGranted rows with no
  /// confirmedAt. The row still grants its features while attached
  /// (the registry is untouched), so the shop never breaks during
  /// trial/grace — only the billing waits for a knowing choice.
  trialGranted   Boolean      @default(false)
  /// When the tenant kept this add-on in the conversion review, or an
  /// operator confirmed/attached it deliberately. Null = unconfirmed.
  confirmedAt    DateTime?

  @@unique([subscriptionId, addOnId])
  @@index([addOnId])
}

model Invoice {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  number         String        @unique
  status         InvoiceStatus @default(OPEN)
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("BDT")
  dueAt          DateTime
  paidAt         DateTime?
  periodStart    DateTime?
  periodEnd      DateTime?
  notes          String?
  /// Invoice kind (pricing engine §5). SUBSCRIPTION = fixed renewal,
  /// METERED = post-paid usage invoice, ONE_TIME = one-time purchase,
  /// MANUAL = operator-created, TOPUP = SMTP email-balance top-up
  /// (created here; used by the SMTP top-up flow).
  kind           InvoiceKind   @default(MANUAL)
  /// Billing computation trace (pricing engine §4): usage read, rates,
  /// sources. Never filtered on — no index by design.
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines              InvoiceLine[]
  proofs             PaymentProof[]
  payments           Payment[]
  creditNotes        CreditNote[]
  couponRedemptions  CouponRedemption[]
  purchase           TenantPurchase?
  topUp              EmailTopUp?

  @@index([tenantId, status])
  @@index([status, dueAt])
  @@index([subscriptionId, status, periodStart])
  @@index([createdAt])
  @@index([kind, status, createdAt])
}

/// One row per reminder actually sent. The unique key stops the jobs from
/// spamming: each (tenant, kind, reference) is sent at most once.
/// referenceId is an invoice id for invoice reminders, a subscription id
/// for the trial-ending reminder.
model InvoiceReminder {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind        String
  referenceId String
  sentAt      DateTime @default(now())

  @@unique([tenantId, kind, referenceId])
  @@index([tenantId])
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
}

model PaymentMethod {
  id            String            @id @default(uuid())
  type          PaymentMethodType
  name          String
  accountName   String?
  accountNumber String?
  instructions  String?           @db.Text
  qrMediaUrl    String?
  isActive      Boolean           @default(true)
  sortOrder     Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  proofs   PaymentProof[]
  payments Payment[]

  @@index([type, isActive])
}

model PaymentProof {
  id              String             @id @default(uuid())
  invoiceId       String
  invoice         Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  methodId        String
  method          PaymentMethod      @relation(fields: [methodId], references: [id], onDelete: Restrict)
  amount          Decimal            @db.Decimal(12, 2)
  transactionId   String
  senderNumber    String?
  screenshotUrl   String?
  note            String?
  status          PaymentProofStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  payments Payment[]

  // No full unique on (methodId, transactionId): a REJECTED proof's
  // transaction id must be resubmittable. Duplicate detection for live
  // proofs is the PARTIAL unique index in migration
  // 20261116230000_phase7_billing_lifecycle (status IN PENDING/APPROVED),
  // maintained in SQL — Prisma has no partial-index support.
  @@index([tenantId, status])
  @@index([status, createdAt])
}

model Payment {
  id         String         @id @default(uuid())
  invoiceId  String
  invoice    Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  methodId   String
  method     PaymentMethod  @relation(fields: [methodId], references: [id], onDelete: Restrict)
  proofId    String?
  proof      PaymentProof?  @relation(fields: [proofId], references: [id], onDelete: SetNull)
  amount     Decimal        @db.Decimal(12, 2)
  currency   String         @default("BDT")
  reference  String?
  receivedAt DateTime       @default(now())
  recordedBy String?
  createdAt  DateTime       @default(now())

  @@index([tenantId, receivedAt])
  @@index([invoiceId])
}

model CreditNote {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("BDT")
  reason           String
  appliedInvoiceId String?
  appliedInvoice   Invoice? @relation(fields: [appliedInvoiceId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())

  @@index([tenantId, appliedInvoiceId, createdAt])
}

model Coupon {
  id             String         @id @default(uuid())
  code           String         @unique
  type           CouponType
  value          Decimal        @db.Decimal(12, 2)
  duration       CouponDuration
  durationMonths Int?
  planIds        String[]       @default([])
  maxRedemptions Int?
  redeemedCount  Int            @default(0)
  expiresAt      DateTime?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([couponId, tenantId])
  @@index([tenantId])
}

model UsageDaily {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  metric    String
  value     Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date, metric])
  @@index([metric, date])
}

/**
 * Per-tenant numeric limit override applied on top of the plan version.
 * Absence of a row means "use the plan value"; a value always overrides the
 * plan, including when the plan does not define the key (upsell/downgrade
 * negotiations). Values follow the shared limit semantics: finite integer >= 0.
 */
model TenantLimitOverride {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Int
  note      String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([key])
}

model AuditLog {
  id        String          @id @default(uuid())
  actorType AuditActorType
  actorId   String?
  actor     PlatformUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId  String?
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model ImpersonationSession {
  id             String       @id @default(uuid())
  platformUserId String
  platformUser   PlatformUser @relation(fields: [platformUserId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenJti       String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([tenantId, createdAt])
}

model ProvisioningJob {
  id        String             @id @default(uuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// The signup that owns this job. Unique so a retried verification cannot
  /// create a second job/tenant for the same request.
  signupId  String?            @unique
  status    ProvisioningStatus @default(PENDING)
  step      String             @default("queued")
  error     String?            @db.Text
  attempts  Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([tenantId, status])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  processedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([processedAt, createdAt])
}

/// A contact request from the public landing lead form (POST /public/leads).
/// Low-privilege record: no account, no auth. Triaged from the console
/// (GET/PATCH /leads) by operators.
/// Consent + UTM are captured from the form (Batch 1): consentGiven is
/// true when the visitor ticked the consent checkbox, consentText stores
/// the exact label shown at submit time (proof of what was agreed to).
/// convertedTenantId links a Won lead to the tenant it became (C1:
/// "Convert lead to tenant" from the console); SetNull on tenant purge
/// so the lead record survives its tenant.
model Lead {
  id            String          @id @default(uuid())
  name          String
  contact       String
  contactType   LeadContactType
  message       String?         @db.Text
  monthlyOrders String?
  source        String          @default("landing_page_lead_form")
  status        LeadStatus      @default(NEW)
  consentGiven  Boolean         @default(false)
  consentText   String?         @db.Text
  utmSource     String?
  utmCampaign   String?
  /// Operator the lead is assigned to (Batch 2, item 12). SetNull on
  /// operator delete so the lead survives its assignee. Back-field on
  /// PlatformUser is `assignedLeads` (same pattern as
  /// LeadConvertedTenant / convertedFromLeads).
  assignedToId  String?
  assignedTo    PlatformUser? @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// When the next follow-up is due. Overdue = followUpAt < now AND
  /// status NOT IN (WON, CLOSED, LOST) — see LeadsService.buildWhere.
  followUpAt    DateTime?
  /// Operator-only working notes (never shown to the lead).
  internalNotes String?       @db.Text
  convertedTenantId String?
  convertedTenant Tenant?       @relation("LeadConvertedTenant", fields: [convertedTenantId], references: [id], onDelete: SetNull)
  ip            String?
  userAgent     String?         @db.Text
  /// Ad attribution capture (CMS batch 2, item 21): Meta browser id /
  /// click id / dedup event id + TikTok click id / dedup event id, sent
  /// by the lead form when present. No Pixel is loaded on the landing,
  /// so these are usually null — the dispatchers send only what exists.
  fbp           String?
  fbc           String?
  eventId       String?
  ttclid        String?
  tiktokEventId String?
  adDispatches  AdDispatch[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([convertedTenantId])
  @@index([assignedToId])
  @@index([followUpAt])
}

/// One ad-platform dispatch for a lead (CMS batch 2, item 21): a durable
/// retry-queue row for Meta Conversions API / TikTok Events API (and any
/// future platform — `platform` is a String validated at the API layer
/// against the configured platforms, so a new platform needs no
/// migration). Backoff ladder 1m/5m/30m/2h/12h (mirror of the reference
/// dispatch_queue): 5 retries, so after the 6th failed attempt the row
/// is terminal `failed` until an operator retries it from the lead drawer.
///
/// status: pending = queued or retrying (nextRetryAt in the future);
/// sent = delivered (sentAt set); failed = ladder exhausted.
/// attempts counts send attempts; lastError carries the last failure
/// for the lead drawer.
model AdDispatch {
  id          String    @id @default(uuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform    String
  eventName   String
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  nextRetryAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([leadId, platform, eventName])
  @@index([status, nextRetryAt])
}

/// One manageable piece of the public SaaS landing content (plan §13:
/// a SINGLE flexible model, not per-section models — the managed types
/// vary in shape: scalars, lists, nested objects).
///
/// section: hero | capabilities | faq | testimonials | partners | contact
/// | seo | leadForm | proof | faqMeta | pricingCopy | gettingStarted |
/// walkthrough | videoSection | heroTabs | dock | header | nav | footer |
/// footerLinks (see landing-content.constants.ts for the authoritative
/// list and the per-section public shapes).
/// key: hero/contact/seo = field name (e.g. headlinePart1); capabilities
/// and the single-object sections (leadForm, proof, ...) = section id or
/// 'main'; faq/testimonials/partners/nav/footerLinks = item slug.
/// locale: 'en' | 'bn'. value: a JSON string (hero/contact/seo scalars)
/// or a JSON object (capability / object-section / list item); arrays and
/// null are rejected at the API layer.
/// Public GET /public/landing-content groups active rows by locale then
/// section; the landing falls back to built-in content for missing
/// sections, so an empty table is a valid state.
model LandingContent {
  id        String   @id @default(uuid())
  section   String
  key       String
  locale    String
  value     Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  /// Draft/publish (CMS batch 2, item 17): 'draft' | 'published'.
  /// A String validated at the API layer — like sections, intentionally
  /// NOT a Prisma enum. New rows are drafts; the migration backfills
  /// existing rows as published (they were live the moment they were
  /// saved). Public read serves published + active rows; a draft row's
  /// last published revision still serves as the live copy.
  status    String   @default("draft")
  /// Optimistic-locking counter. PATCH requires expectedVersion and
  /// bumps this on every successful edit; publish never changes it.
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  revisions LandingContentRevision[]

  @@unique([section, key, locale])
  @@index([section, locale, sortOrder])
  @@index([status, isActive])
}

/// Snapshot of a published LandingContent payload (CMS batch 2,
/// item 17). Created on publish (the payload that went live) and when
/// a published row is edited or restored (so the live copy survives
/// the edit as a draft). Append-only: a restore creates a NEW draft
/// version holding the snapshot's payload — history is never
/// rewritten. version = the row's version at snapshot time.
model LandingContentRevision {
  id               String         @id @default(uuid())
  landingContentId String
  landingContent   LandingContent @relation(fields: [landingContentId], references: [id], onDelete: Cascade)
  version          Int
  value            Json
  actorId          String?
  note             String?
  createdAt        DateTime       @default(now())

  @@index([landingContentId, version])
  @@index([landingContentId, createdAt])
}

/// A published customer case study for the public landing
/// (/case-studies + /case-studies/[slug]; console /case-studies).
/// A dedicated model, not a LandingContent section: slugs must be
/// unique and routable, and the public list/detail reads are
/// slug-keyed. Metrics are [{ stat, label }] lines — the same shape
/// as testimonial metrics. Only isPublished rows are ever served by
/// the public endpoints; drafts exist for the console only.
model CaseStudy {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  client           String
  businessType     String
  problem          String   @db.Text
  solution         String   @db.Text
  outcome          String   @db.Text
  metrics          Json     @default("[]")
  featuredImageUrl String?
  videoUrl         String?
  websiteUrl       String?
  seoTitle         String?
  seoDescription   String?  @db.Text
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isPublished, createdAt])
}

/// One file in the platform media library (console /media; StackMate
/// ADR-0011 pattern, adapted for multi-tenant SaaS).
///
/// Platform/landing assets ONLY — branding logos, landing images, and
/// other public website files. Tenant store media lives in the tenant
/// backend's upload system, never here.
///
/// Each row stores its OWN storage driver ('local' | 'r2'), so reads
/// always use the row's driver and a driver switch never orphans a
/// library file. The object key is server-generated
/// (`media/<yyyy>/<mm>/<uuid>-<sanitized-name>`); only the key, never
/// a public URL, is stored — the public content URL is derived at read
/// time (GET /public/media/:id, see media.service.ts).
///
/// Files are PUBLIC bytes by design (the landing renders them for
/// anonymous visitors); the library itself (list/upload/manage) is
/// authenticated. SVG is sanitized at upload and served with a sandbox
/// CSP, so a stored SVG can never carry an active payload.
model MediaAsset {
  id               String        @id @default(uuid())
  objectKey        String        @unique
  /// 'local' | 'r2'. Enforced in code (media-storage.service.ts) — the
  /// row driver is always the resolved driver name, never user input.
  driver           String        @default("local")
  originalFilename String
  mimeType         String
  byteSize         BigInt
  checksumSha256   String
  width            Int?
  height           Int?
  /// '' = library root; otherwise lowercase slash-separated segments.
  folder           String        @default("")
  tags             String[]      @default([])
  uploadedByUserId String?
  uploadedBy       PlatformUser? @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([folder, createdAt(sort: Desc)])
  @@index([mimeType, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([uploadedByUserId])
}

/// ── Pricing engine (2026-11-18) ──────────────────────────────────────
/// Dynamic pricing: pricing documents on PlanVersion, per-client
/// overrides, one-time purchases, strict-blocking overrides. Migration
/// 20261118155600_pricing_engine (+ backfill 20261118155700). The
/// InvoiceKind enum is created here in full (incl. TOPUP, used by the
/// SMTP top-up flow) so no later migration has to add values to it.

enum InvoiceKind {
  SUBSCRIPTION
  ONE_TIME
  METERED
  MANUAL
  TOPUP
}

enum PurchaseType {
  SETUP_FEE
  LIMIT_INCREASE
  RATE_TIER
  FEATURE_UNLOCK
}

enum PurchaseStatus {
  PENDING
  PAID
  APPLIED
  CANCELLED
}

/// Per-client pricing override (Q7). Overrides win over the plan version
/// and over one-time purchase effects (§4.1). Keys are a closed set:
/// 'per_order_rate' | 'minimum_monthly' (BDT; 0 minimum = no floor).
model TenantPricingOverride {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  value     Decimal  @db.Decimal(12, 4)
  note      String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([key])
}

/// A one-time purchase: setup fee, limit increase, rate tier, or feature
/// unlock (Q3). The invoice is kind ONE_TIME; the effect is applied by
/// approveProof when the invoice becomes PAID (§6 step 4). Status guards
/// make application idempotent.
model TenantPurchase {
  id             String         @id @default(uuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  type           PurchaseType
  feeKey         String
  label          String
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("BDT")
  /// Effect snapshot taken at purchase time (limits / rate / features).
  effect         Json
  status         PurchaseStatus @default(PENDING)
  invoiceId      String?        @unique
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy      String?
  appliedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tenantId, status])
  @@index([subscriptionId])
}

/// Per-client strict-blocking override (Q4). Absent = plan config wins.
/// One row per tenant; the plan's `blocking` block is the default.
model TenantBlockingOverride {
  tenantId     String   @id
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mode         String
  blockedAreas String[] @default([])
  note         String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── SMTP email balance (smtp-balance-design.md) ─────────────────────────
// The balance is a COUNT of sendable emails, never money. Lots are the
// truth; TenantEmailAccount.balanceCached is a read optimisation kept
// in sync by the same transactions that write the ledger. Migration:
// 20261118175200_smtp_email_balance (+ backfill
// 20261118175300_smtp_email_balance_backfill).

/// One grant of emails. Balance = Σ emailsRemaining over unexpired lots.
/// Lots are never edited in place except for emailsRemaining decrements
/// (and expiry, which zeroes it).
model EmailBalanceLot {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source          EmailLotSource
  emailsTotal     Int
  emailsRemaining Int
  /// null = never expires; else computed at grant time from the
  /// saas_smtp expiry setting (grandfathered — later setting changes
  /// never rewrite existing lots).
  expiresAt       DateTime?
  topUpId         String?
  topUp           EmailTopUp?    @relation(fields: [topUpId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())

  ledger EmailBalanceLedger[]

  @@index([tenantId, expiresAt])
  @@index([expiresAt])
  @@index([tenantId, createdAt])
}

/// Append-only audit trail. balanceAfter is the reconciliation anchor.
/// Rows are never updated or deleted. reference is the BullMQ job id for
/// SENDs, the invoice number for grants, the lot id for expiries.
/// A partial unique index (tenantId, reference) WHERE kind = 'SEND' lives
/// in the migration SQL (Prisma has no partial-index support) — the
/// idempotency guard for retried send jobs.
model EmailBalanceLedger {
  id           String           @id @default(uuid())
  tenantId     String
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lotId        String?
  lot          EmailBalanceLot? @relation(fields: [lotId], references: [id], onDelete: SetNull)
  kind         EmailLedgerKind
  delta        Int
  balanceAfter Int
  reference    String?
  note         String?
  createdAt    DateTime         @default(now())

  @@index([tenantId, createdAt])
}

/// A top-up purchase: money in, emails out. The invoice is kind TOPUP
/// (InvoiceKind, created by the pricing migration). The rate snapshot is
/// stored at purchase time so a later rate change never rewrites it.
model EmailTopUp {
  id            String           @id @default(uuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId     String           @unique
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountBDT     Decimal          @db.Decimal(12, 2)
  emailsGranted Int
  /// Rate snapshot at purchase time: { unit, pricePerUnit }.
  rateSnapshot  Json
  status        EmailTopUpStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  paidAt        DateTime?

  lots EmailBalanceLot[]

  @@index([tenantId, status])
}

/// Per-tenant balance state: cached counter + one-shot flags.
/// balanceCached is updated in the same transaction as every ledger
/// write; the nightly email-balance-reconcile job proves it matches
/// Σ lots and fixes any drift.
model TenantEmailAccount {
  tenantId             String    @id
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balanceCached        Int       @default(0)
  freeGrantClaimed     Boolean   @default(false)
  lowBalanceNotifiedAt DateTime?
  updatedAt            DateTime  @updatedAt
}

/// ── Blog (Landing CMS Batch 2, item 20) ─────────────────────────────
/// Public SaaS landing blog: bilingual posts, hierarchical categories,
/// tags. Migration 20261119140000_blog.
///
/// SLUG UNIQUENESS: slugs are unique among LIVE posts only — a soft-
/// deleted post FREES its slug (a new post may reuse it). Prisma has
/// no partial-unique-index support, so the schema deliberately has NO
/// @@unique([slug]) here; the partial unique index
///   CREATE UNIQUE INDEX "BlogPost_slug_live_key"
///     ON "BlogPost"("slug") WHERE "deletedAt" IS NULL
/// lives in the migration SQL, and BlogService enforces live-slug
/// uniqueness in code (409 on clash) with the index as a race backstop
/// (P2002 → 409).
///
/// STATUS is a String validated at the API layer
/// (draft | scheduled | published | archived) — intentionally NOT a
/// Prisma enum, like the landing sections: a new status needs no
/// migration. A post with status 'scheduled' and publishedAt <= now
/// counts as published in public reads (on-read publish check —
/// no cron; see BlogService.effectiveStatus).
///
/// CONTENT is Tiptap HTML (console editor), NOT markdown. The landing
/// sanitizes it with isomorphic-dompurify before rendering.
model BlogPost {
  id               String        @id @default(uuid())
  titleEn          String
  titleBn          String
  /// URL slug. Unique among live posts only (see the header comment).
  slug             String
  excerptEn        String?
  excerptBn        String?
  /// Tiptap HTML.
  contentEn        String        @db.Text
  contentBn        String        @db.Text @default("")
  author           String        @default("")
  categoryId       String?
  category         BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImageUrl String?
  videoUrl         String?
  galleryUrls      String[]      @default([])
  /// Minutes. Auto-computed from contentEn on save when omitted.
  readTime         Int?
  /// draft | scheduled | published | archived (API-validated).
  status           String        @default("draft")
  /// Publish time: for 'scheduled' posts the go-live moment; for
  /// 'published' posts the display date (auto-set to now on publish
  /// when omitted).
  publishedAt      DateTime?
  seoTitleEn       String?
  seoTitleBn       String?
  seoDescEn        String?
  seoDescBn        String?
  canonicalUrl     String?
  /// Soft delete (slug freed — see the header comment).
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tags BlogPostTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([slug])
  /// The public-list predicate (deletedAt IS NULL + status +
  /// publishedAt ordering) in one index.
  @@index([deletedAt, status, publishedAt])
}

/// Hierarchical blog category (Category → Sub-category →
/// Sub-sub-category, …). Children of a deleted category become roots
/// (parentId SetNull); posts of a deleted category lose it (SetNull).
model BlogCategory {
  id        String         @id @default(uuid())
  nameEn    String
  nameBn    String
  descEn    String?
  descBn    String?
  slug      String         @unique
  parentId  String?
  parent    BlogCategory?  @relation("BlogCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  BlogCategory[] @relation("BlogCategoryTree")
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  posts BlogPost[]

  @@index([parentId])
}

model BlogTag {
  id        String   @id @default(uuid())
  nameEn    String
  nameBn    String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPostTag[]
}

model BlogPostTag {
  id        String   @id @default(uuid())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId     String
  tag       BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, tagId])
  @@index([tagId])
}
