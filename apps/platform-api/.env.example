PLATFORM_PORT=4100
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecomate_platform
PLATFORM_JWT_SECRET=
PLATFORM_JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
# Console auth mode (Phase 4 central Better Auth cutover): custom-jwt
# (default, legacy platform JWT login) or central-ba (verify console
# sessions against the central auth service at AUTH_INTERNAL_URL).
CONSOLE_AUTH_MODE=custom-jwt
AUTH_INTERNAL_URL=http://auth-service:4200
SAAS_PRIMARY_DOMAIN=ecomate.bd
SAAS_BASE_DOMAINS=ecomate.bd
SAAS_FALLBACK_DOMAIN=
SAAS_CUSTOM_DOMAIN_CNAME=cname.ecomate.bd
# App domain (parent of the console/API hosts). Empty = legacy
# single-domain mode (hosts derive from SAAS_PRIMARY_DOMAIN). When set it
# must be fully separate from the tenant domain.
SAAS_APP_DOMAIN=
# Set true during a primary-domain/TLS outage: new absolute URLs use
# SAAS_FALLBACK_DOMAIN; health reports primaryHealthy=false.
SAAS_PRIMARY_UNHEALTHY=false

# Public landing/signup origin used in verification emails.
PLATFORM_LANDING_URL=http://localhost:3002
# Platform console origin used in invite emails (accept-invite links).
PLATFORM_ADMIN_URL=http://localhost:5174
# Tenant backend used by the provisioning job (internal bootstrap endpoint).
TENANT_BACKEND_URL=http://backend:4000/api
# Optional explicit plan version for self-serve trials; otherwise the
# version flagged as the signup default (isDefault) is used, falling back
# to the newest active version only when no default is set. The platform
# seed creates a free `trial` plan and marks it the default.
DEFAULT_PLAN_VERSION_ID=
# A RUNNING job older than this is treated as interrupted and made retryable.
PROVISIONING_STALE_MS=600000
# Deleted tenants keep all data for this many days before the purge job may
# destroy them. Every purge exports first; a failed export aborts destruction.
TENANT_RETENTION_DAYS=30
TENANT_PURGE_INTERVAL_MS=21600000
TENANT_PURGE_ENABLED=true
# Persistent directory for tenant JSON exports (mount a volume in production).
TENANT_EXPORT_DIR=./data/tenant-exports
# One-time tenant impersonation link lifetime (60–3600 seconds).
IMPERSONATION_TTL_SECONDS=900
# Cloudflare Turnstile secret. With no secret, production signup fails closed;
# dev/test skips the challenge.
TURNSTILE_SECRET_KEY=
# Extra disposable email domains, comma-separated (built-in list always on).
SIGNUP_DISPOSABLE_DOMAINS=
# Outbound mail (verification links). In development with no SMTP_HOST the
# link is logged; production fails closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PLATFORM_MAIL_FROM=EcoMate <no-reply@ecomate.bd>

# Caddy on-demand TLS: the ask endpoint requires this token in the query string
# (Caddyfile: .../allow?token={env.TLS_ASK_TOKEN}). Falls back to
# INTERNAL_SERVICE_SECRET when unset. Keep the endpoint on the private network.
TLS_ASK_TOKEN=

# Custom-domain DNS polling (PENDING custom domains are re-checked in the
# background; each domain at most once per window). Set enabled=false to rely
# on manual POST /tenants/:id/domains/:domainId/verify only.
CUSTOM_DOMAIN_POLL_MS=60000
CUSTOM_DOMAIN_POLL_ENABLED=true

# Billing lifecycle jobs (Phase 7): trial expiry, renewal invoices, invoice
# reminders, grace/suspend/cancel, cancel-at-period-end. The runner is
# in-process (single instance only); each job is idempotent and can also be
# triggered manually via POST /jobs/:name/run.
BILLING_JOBS_ENABLED=true
BILLING_JOBS_INTERVAL_MS=3600000
BILLING_CANCEL_AFTER_DAYS=30

# Ad dispatch (CMS batch 2, item 21): durable retry queue for lead events
# to Meta Conversions API / TikTok Events API. Dedicated in-process
# processor (single instance only — the billing runner ticks hourly,
# too slow for the 1m first retry); a manual run is POST /ad-dispatch/process.
AD_DISPATCH_ENABLED=true
AD_DISPATCH_INTERVAL_MS=60000
# Sender selection: unset = the real per-platform senders (Meta CAPI,
# TikTok Events API); 'stub' = the in-memory stub sender (tests + live
# verification only — never the network).
AD_DISPATCH_SENDER=
# In stub mode, fail this many sends before succeeding (retry testing).
AD_DISPATCH_STUB_FAIL_COUNT=0
# Event source URL sent with each event (the landing page); unset = omitted.
AD_DISPATCH_EVENT_SOURCE_URL=

# AES-256-GCM key for secrets at rest (stored SMTP password, TOTP MFA
# secrets, ad tracking access tokens). 64 hex chars; generate with
# `openssl rand -hex 32`. No safe default: SMTP/MFA/ad-token writes fail
# without it, and changing it later makes existing ciphertext unreadable.
# Back it up alongside the database.
APP_ENCRYPTION_KEY=
# Redis used by the platform rate limiter (login/refresh/MFA/verify/status/
# invite-accept + signup). Falls back to in-memory counters when unreachable.
REDIS_URL=redis://127.0.0.1:6379
# Short-lived token for the MFA second step / mid-login enrollment (seconds).
PLATFORM_MFA_TOKEN_TTL_SECONDS=300
# Grace window (ms) in which replaying a just-rotated refresh token is a
# plain 401 (console concurrent-refresh race) instead of a family revoke.
PLATFORM_REFRESH_REUSE_GRACE_MS=30000

# First platform superadmin (used by `npm run platform:seed`)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin

# --- Phase 8 Stage 2 observability + TLS health (items 19-20, 25) ---
# Structured JSON log level (debug|info|warn|error; default info).
LOG_LEVEL=info
# Sentry DSN. Disabled when unset, empty, or a placeholder.
SENTRY_DSN=
# Ops alert recipients (comma-separated). Alerts are skipped when unset.
OPS_ALERT_EMAIL=
# Minimum ms between alerts of the same kind (default 900000 = 15 min).
OPS_ALERT_MIN_INTERVAL_MS=900000
# Billing-job failure watcher (default on, polls every 5 min).
JOB_WATCHER_ENABLED=true
JOB_WATCHER_INTERVAL_MS=300000
# TLS/domain health job (default on, probes verified custom domains hourly).
TLS_PROBE_ENABLED=true
TLS_PROBE_INTERVAL_MS=3600000
# Alert when a cert expires within this many days (default 14).
TLS_EXPIRY_ALERT_DAYS=14
# Port the TLS probe connects to (443 in production; override for local
# test servers).
TLS_PROBE_PORT=443
# Per-probe timeout in ms (default 10000).
TLS_PROBE_TIMEOUT_MS=10000
# Primary-domain probe: replaces the manual SAAS_PRIMARY_UNHEALTHY flag
# with a live probe (the flag stays as a manual override). Default: on in
# production, off elsewhere; set explicitly to force either way.
TLS_PRIMARY_PROBE_ENABLED=
