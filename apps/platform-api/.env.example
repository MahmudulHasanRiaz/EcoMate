PLATFORM_PORT=4100
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecomate_platform
PLATFORM_JWT_SECRET=
PLATFORM_JWT_REFRESH_SECRET=
INTERNAL_SERVICE_SECRET=
SAAS_PRIMARY_DOMAIN=ecomate.bd
SAAS_BASE_DOMAINS=ecomate.bd
SAAS_FALLBACK_DOMAIN=
SAAS_CUSTOM_DOMAIN_CNAME=cname.ecomate.bd
# Set true during a primary-domain/TLS outage: new absolute URLs use
# SAAS_FALLBACK_DOMAIN; health reports primaryHealthy=false.
SAAS_PRIMARY_UNHEALTHY=false

# Public landing/signup origin used in verification emails.
PLATFORM_LANDING_URL=http://localhost:3002
# Tenant backend used by the provisioning job (internal bootstrap endpoint).
TENANT_BACKEND_URL=http://backend:4000/api
# Optional explicit plan version for self-serve trials; otherwise the newest
# active plan version is used. The platform seed creates a free `trial` plan.
DEFAULT_PLAN_VERSION_ID=
# A RUNNING job older than this is treated as interrupted and made retryable.
PROVISIONING_STALE_MS=600000
# Deleted tenants keep all data for this many days before the purge job may
# destroy them. Every purge exports first; a failed export aborts destruction.
TENANT_RETENTION_DAYS=30
TENANT_PURGE_INTERVAL_MS=21600000
TENANT_PURGE_ENABLED=true
# Persistent directory for tenant JSON exports (mount a volume in production).
TENANT_EXPORT_DIR=./data/tenant-exports
# One-time tenant impersonation link lifetime (60–3600 seconds).
IMPERSONATION_TTL_SECONDS=900
# Cloudflare Turnstile secret. With no secret, production signup fails closed;
# dev/test skips the challenge.
TURNSTILE_SECRET_KEY=
# Extra disposable email domains, comma-separated (built-in list always on).
SIGNUP_DISPOSABLE_DOMAINS=
# Outbound mail (verification links). In development with no SMTP_HOST the
# link is logged; production fails closed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PLATFORM_MAIL_FROM=EcoMate <no-reply@ecomate.bd>

# Caddy on-demand TLS: the ask endpoint requires this token in the query string
# (Caddyfile: .../allow?token={env.TLS_ASK_TOKEN}). Falls back to
# INTERNAL_SERVICE_SECRET when unset. Keep the endpoint on the private network.
TLS_ASK_TOKEN=

# Custom-domain DNS polling (PENDING custom domains are re-checked in the
# background; each domain at most once per window). Set enabled=false to rely
# on manual POST /tenants/:id/domains/:domainId/verify only.
CUSTOM_DOMAIN_POLL_MS=60000
CUSTOM_DOMAIN_POLL_ENABLED=true

# First platform superadmin (used by `npm run platform:seed`)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
