{
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.28",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.28",
    "nodemailer": "10.1.4",
    "prisma": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.21.0"
  },
  "description": "Central Better Auth service for EcoMate (one Better Auth + organization plugin for all tenants and the SaaS console).",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.22.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "name": "auth-service",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "prebuild": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:status": "prisma migrate status",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "postbuild": "rm -rf dist/generated && cp -r src/generated dist/generated"
  },
  "type": "module",
  "version": "0.1.0"
}
