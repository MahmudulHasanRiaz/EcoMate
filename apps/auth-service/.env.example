# EcoMate central auth service — environment template.
# Copy to .env for local runs. Production values come from the secret
# store / Portainer stack env (see README "Deploy" for the compose snippet).
# NEVER commit a real .env.

# Required in production (the service throws at boot without it).
# Fresh random secret, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=

# Required. Postgres DSN for the DEDICATED ecomate_auth database (D2=A).
# Local scratch: postgresql://postgres@127.0.0.1:55432/ecomate_auth
# Compose: postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/ecomate_auth
AUTH_DB_URL=

# Public origin of this service (plan §3.1 decision A):
# prod https://auth.em.commercians.com, staging https://auth.staging.em.commercians.com
AUTH_PUBLIC_URL=http://localhost:4200
# Internal origin the backends call (compose service name + port).
AUTH_INTERNAL_URL=http://localhost:4200

# Port the service listens on (default 4200).
AUTH_PORT=4200
# Bind host (0.0.0.0 in containers).
AUTH_HOST=0.0.0.0

# Hosts Better Auth accepts as the request host (baseURL.allowedHosts).
# NO fallback host is configured — unknown hosts fail closed (500).
AUTH_ALLOWED_HOSTS=faah.net,*.faah.net,em.commercians.com,ecomate.bd,*.ecomate.bd
# Protocol used when BA builds callback/reset URLs: https in production,
# http only for local dev / tests.
AUTH_BASE_PROTOCOL=https

# Hosts trusted as request Origins for mutations (Phase 1: config allowlist;
# Phase 3: union of this allowlist + the live platform-registry lookup —
# verified custom domains + tenant subdomains — see src/tenant-registry.ts).
AUTH_TRUSTED_HOSTS=faah.net,em.commercians.com,ecomate.bd

# Trusted reverse-proxy IPs/CIDR ranges for advanced.ipAddress (comma list).
# BA walks the X-Forwarded-For chain right-to-left past these; empty =
# trust single-value X-Forwarded-For only. Set to the upstream proxy's
# egress ranges (Cloudflare's published ranges) when one fronts Caddy.
AUTH_TRUSTED_PROXIES=

# Max organizations per user (D12; default 5, console-configurable later).
AUTH_ORG_LIMIT=5
# Max members per organization (staff only — customers are never members).
AUTH_MEMBERSHIP_LIMIT=100

# Internal service-to-service auth (D8 issue/provision/role-sync routes).
# REQUIRED in production: without it /internal/* answers 503.
# Fresh random secret shared with platform-api (same value both sides).
INTERNAL_SERVICE_SECRET=
# Platform-api base URL (org-limit setting fetch + impersonation-consumed
# callback + tenant-registry lookup). Must carry the /api prefix and the
# platform-api port (4100): http://platform-api:4100/api on the stack.
# Empty = env fallback only for the org limit, config allowlist only for
# trustedOrigins, and the legacy host check on impersonation consume.
AUTH_PLATFORM_API_URL=http://localhost:4100/api
# Impersonation handoff + session TTL in seconds (default 900, clamped 60–3600).
IMPERSONATION_TTL_SECONDS=900
# Tenant primary domain used for handoff URLs (slug.<domain>, never custom).
AUTH_TENANT_PRIMARY_DOMAIN=faah.net
# Q11 kill-switch: reject social sign-in for TOTP users (loginHint only).
# Default false — the callback hook is the gate.
AUTH_SOCIAL_TOTP_STRICT=false

# Fake generic-OAuth IdP for tests ONLY (NODE_ENV=test + both URLs set).
# Never set in production — the provider is not registered otherwise.
AUTH_FAKE_IDP_AUTHORIZATION_URL=
AUTH_FAKE_IDP_TOKEN_URL=

# Mail: verification + reset emails. Same env shape as the backend mailer,
# prefixed AUTH_. AUTH_MAIL_MODE=test captures the URL in-process instead
# of sending (smoke tests only — never in production).
AUTH_MAIL_MODE=smtp
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_SECURE=false
AUTH_SMTP_USER=
AUTH_SMTP_PASS=
AUTH_SMTP_FROM=EcoMate <no-reply@ecomate.bd>

# Social providers (D9=B, BA built-in OAuth). Empty id/secret = disabled.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Account lockout (tenant parity: 4th failed attempt locks 15 min).
AUTH_LOCKOUT_MAX_ATTEMPTS=4
AUTH_LOCKOUT_MINUTES=15
# Per-IP sign-in failure block (tenant hijack limiter parity).
AUTH_IP_SIGNIN_MAX_FAILURES=10
AUTH_IP_SIGNIN_WINDOW_SECONDS=60
AUTH_IP_SIGNIN_BLOCK_MINUTES=15
# Per-IP MFA-challenge attempt cap (platform /challenge parity: 10/10 min).
AUTH_IP_MFA_MAX_ATTEMPTS=10
AUTH_IP_MFA_WINDOW_SECONDS=600
