{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(ts|js|mjs)$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(uuid|better-auth|@noble|jose|@better-auth|@better-fetch|better-call|defu|rou3|nanostores|kysely)/)"
  ]
}
