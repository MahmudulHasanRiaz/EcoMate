DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecomate_web"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-string-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
APP_URL="http://localhost:4000"

# License Activation
# Encryption key for storing license credentials at rest (64 hex chars = 32 bytes for AES-256)
# Generate: openssl rand -hex 32
LICENSE_ENCRYPTION_KEY="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Shared secret for internal service-to-service calls (see root .env.example).
INTERNAL_SHARED_SECRET=""

# KeyMate License Server URL
KEYMATE_API_URL="https://keygen-keymate.commercians.com/api/v1/saas"

# Legacy env vars (no longer read for activation — kept for backward compatibility)
# LICENSE_KEY=
# LICENSE_TOKEN=
# KEYMATE_API_KEY=
# DOMAIN=
PLATFORM_API_URL=http://localhost:4100/api
TENANT_REGISTRY_REFRESH_MS=60000
INTERNAL_SERVICE_SECRET=
# Shared secret for the internal x-tenant-host/rate-limit trust check.
INTERNAL_SHARED_SECRET=
# Tenant access-token lifetime issued by /auth/impersonate.
IMPERSONATION_TTL_SECONDS=900
# --- Phase 3 central-auth cutover ---
# TENANT_AUTH_MODE=legacy-jwt (default): DualModeAuthGuard + tenant BA
# writes. central-ba: CentralSessionAuthGuard verifies sessions against
# the central auth service over HTTP; users/employees/customer-linking
# call its internal user endpoints. NO live flip in Phase 3 — the flag
# default keeps current behaviour.
TENANT_AUTH_MODE=legacy-jwt
# Internal URL of the central auth service (compose service name; the
# guard forwards the tenant Host header on every call). AUTH_SERVICE_URL
# is accepted as a fallback name.
AUTH_INTERNAL_URL=http://auth-service:4200
# Full-tenant export aborts above this many rows in one table.
TENANT_EXPORT_MAX_ROWS=250000

# --- Phase 8 Stage 2 observability + backup (items 19-22, 25) ---
# Structured JSON log level (debug|info|warn|error; default info).
LOG_LEVEL=info
# Sentry DSN. Disabled when unset, empty, or a placeholder (no account
# needed until ops is ready to enable it).
SENTRY_DSN=
# Ops alert recipients (comma-separated). Alerts are skipped when unset.
OPS_ALERT_EMAIL=
# Minimum ms between alerts of the same kind (default 900000 = 15 min).
OPS_ALERT_MIN_INTERVAL_MS=900000
# Direct SMTP for ops alerts (bypasses the email queue — an alert about a
# broken queue must not depend on it). Falls back to the fallback-tenant
# SystemSetting smtp_* rows when unset.
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=
# BullMQ queue watcher: alerts on depth/failed jobs (default on).
QUEUE_WATCHER_ENABLED=true
QUEUE_WATCHER_INTERVAL_MS=60000
QUEUE_DEPTH_ALERT_THRESHOLD=1000
# Bull Board dashboard at /api/admin/queues (tenant superadmin only).
BULL_BOARD_ENABLED=true
# Platform database URL — db_files backups dump it into platform.sql and
# restores replay it first. Unset = tenant-only backups (with a warning).
PLATFORM_DATABASE_URL=postgresql://user:pass@host:5432/ecomate_platform
