# ==========================================
# ECOMATE WEB — PORTAINER STACK ENVIRONMENT
# ==========================================
# Copy this file to .env and fill in the values before deploying.
# Fields marked with ⭐ are REQUIRED and must be changed.

# ==========================================
# ECOMATE SAAS — PLATFORM / DOMAIN CONFIG
# ==========================================
# The SaaS product uses these values. The legacy CLIENT_DOMAIN below is kept
# only for the archived single-tenant product during the conversion.
SAAS_PRIMARY_DOMAIN=ecomate.bd
# Ordered base domains for tenant subdomains. The first entry MUST equal
# SAAS_PRIMARY_DOMAIN. Add more domains at runtime from the SaaS admin.
SAAS_BASE_DOMAINS=ecomate.bd
# Optional fallback domain for absolute URLs when the primary is unavailable.
# Must be in SAAS_BASE_DOMAINS unless SAAS_ALLOW_EXTERNAL_FALLBACK=true.
SAAS_FALLBACK_DOMAIN=
SAAS_CUSTOM_DOMAIN_CNAME=cname.ecomate.bd
SAAS_ALLOW_EXTERNAL_FALLBACK=false
# Set true during a primary-domain/TLS outage: new absolute URLs and storefront
# redirects use SAAS_FALLBACK_DOMAIN while canonical URLs stay canonical.
SAAS_PRIMARY_UNHEALTHY=false
# Platform control-plane database (separate from the tenant database).
PLATFORM_API_URL=http://platform-api:4100/api
PLATFORM_PORT=4100
# Public landing/signup origin; verification emails link to
# <PLATFORM_LANDING_URL>/verify-email?token=...
PLATFORM_LANDING_URL=https://www.ecomate.bd
# Platform console origin; invite emails link to
# <PLATFORM_ADMIN_URL>/accept-invite?token=...
PLATFORM_ADMIN_URL=https://saas.ecomate.bd
# Edge hosts (Caddyfile {$VAR:default}s). Defaults derive from
# SAAS_PRIMARY_DOMAIN in compose; set explicitly only to diverge.
PLATFORM_LANDING_HOST=www.ecomate.bd
PLATFORM_ADMIN_HOST=saas.ecomate.bd
PLATFORM_API_HOST=api.ecomate.bd
# Let's Encrypt account email (expiry notices). Caddy rejects an empty email
# at config load, so the default is support@ecomate.bd (also the billing
# supportEmail default); override with your own address.
ACME_EMAIL=support@ecomate.bd
# Tenant backend used by the provisioning job (internal bootstrap endpoint).
TENANT_BACKEND_URL=http://backend:4000/api
# Internal landing URL for the cache purge (platform-api calls the
# landing's POST /api/revalidate with INTERNAL_SERVICE_SECRET).
LANDING_INTERNAL_URL=http://landing:3002
# Search-engine indexing kill-switch for the landing: 'false' hides it
# from search engines (noindex + robots disallow-all + empty sitemap)
# and wins over the console toggle. Set 'false' on staging.
SEO_INDEXING_ENABLED=true
# Optional explicit plan version for self-serve trials.
DEFAULT_PLAN_VERSION_ID=
# A RUNNING provisioning job older than this is made retryable.
PROVISIONING_STALE_MS=600000
# Deleted tenants retain data for 30 days; purge always exports first.
TENANT_RETENTION_DAYS=30
TENANT_PURGE_INTERVAL_MS=21600000
TENANT_PURGE_ENABLED=true
TENANT_EXPORT_DIR=./data/tenant-exports
# (In the compose stack this is /app/data/tenant-exports on the
# platform-exports-data volume; the relative path above is local dev only.)
# Tenant DB export safety cap per table (abort, never truncate silently).
TENANT_EXPORT_MAX_ROWS=250000
# Media library (platform assets — landing + branding). Files live on the
# platform-media-data volume (compose: /app/data/media); the API serves
# the bytes at GET /api/public/media/:id. MEDIA_STORAGE_DRIVER is LEFT
# EMPTY so the console setting (Settings → Media storage) controls the
# driver; set it to 'local' or 'r2' to lock the driver from the
# environment (env wins, like the SEO flag). MEDIA_PUBLIC_BASE_URL is
# the origin the API writes into content URLs (the public API host, so
# other origins like the landing can load the files); empty = relative
# /api/public/media/:id paths. MEDIA_MAX_BYTES caps each upload
# (default 100 MB); the multipart limit in main.ts reads the same var.
MEDIA_LOCAL_PATH=./data/media
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=104857600
MEDIA_STORAGE_DRIVER=
# One-time tenant impersonation link / access-token lifetime.
IMPERSONATION_TTL_SECONDS=900
# Cloudflare Turnstile. Secret is platform-api only; the site key is baked into
# the landing build. Without a secret, production signup fails closed.
TURNSTILE_SECRET_KEY=
# Extra disposable email domains for trial signup, comma-separated.
SIGNUP_DISPOSABLE_DOMAINS=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Outbound mail for signup verification (platform control plane).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PLATFORM_MAIL_FROM=EcoMate <no-reply@ecomate.bd>
# Explicit From header override; empty = PLATFORM_MAIL_FROM. (Compose
# chains the default through PLATFORM_MAIL_FROM so the code's ?? fallback
# is never broken by an empty value.)
SMTP_FROM=
# Caddy on-demand TLS ask token (same value in Caddy + platform-api;
# falls back to INTERNAL_SERVICE_SECRET when unset). Private network only.
TLS_ASK_TOKEN=
# Custom-domain DNS polling (pending custom domains are re-checked in the
# background; each domain at most once per window).
CUSTOM_DOMAIN_POLL_MS=60000
CUSTOM_DOMAIN_POLL_ENABLED=true
# Billing lifecycle jobs (Phase 7): trial expiry, renewal invoices, invoice
# reminders, grace/suspend/cancel, cancel-at-period-end. In-process runner,
# single instance only — never scale platform-api past 1 replica with jobs
# enabled, or jobs double-run.
BILLING_JOBS_ENABLED=true
BILLING_JOBS_INTERVAL_MS=3600000
BILLING_CANCEL_AFTER_DAYS=30
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecomate_platform
# Tenant runtime DSN (backend tenancy layer; preferred over DATABASE_URL).
# Runtime connects as `ecomate_app` (NOSUPERUSER, NOBYPASSRLS) — never the
# superuser: superusers bypass RLS entirely and the boot-time RLS coverage
# gate refuses to start. The password is TENANT_APP_DB_PASSWORD (required,
# URL-safe); startup.sh provisions the role on every boot. Migrations run
# as the owner via DATABASE_URL. Empty = compose builds it from the parts.
TENANT_DATABASE_URL=
# Password for the ecomate_app tenant runtime role. REQUIRED, no default:
# the backend fails closed without it. URL-safe only (letters, digits,
# hyphen, underscore) — it is embedded in TENANT_DATABASE_URL.
TENANT_APP_DB_PASSWORD=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Platform Admin
# Set to true only on the FIRST deploy: seeds the platform superadmin +
# feature catalog + free trial plan (idempotent upserts).
RUN_PLATFORM_SEED=false
PLATFORM_JWT_SECRET=
PLATFORM_JWT_REFRESH_SECRET=
# Platform token lifetimes in seconds. Real defaults (not empty): the auth
# service reads these with ?? and Number("") is 0 — an empty value would
# make every token expire immediately.
PLATFORM_JWT_EXPIRES_IN_SECONDS=900
PLATFORM_JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Short-lived token for the MFA second step / mid-login enrollment (seconds).
PLATFORM_MFA_TOKEN_TTL_SECONDS=300
# Grace window (ms) in which replaying a just-rotated refresh token is a
# plain 401 (console concurrent-refresh race) instead of a family revoke.
PLATFORM_REFRESH_REUSE_GRACE_MS=30000
# Redis backing for the platform rate limiter (login/refresh/MFA/verify/
# status/invite-accept + signup). Falls back to in-memory counters when
# unreachable.
REDIS_URL=redis://redis:6379
INTERNAL_SERVICE_SECRET=
# Cloudflare Turnstile verify-endpoint override (testing only — default is
# https://challenges.cloudflare.com/turnstile/v0/siteverify).
TURNSTILE_VERIFY_URL=
# 256-bit AES key for app secrets at rest (same key material as the legacy
# LICENSE_ENCRYPTION_KEY, which is still accepted as a transitional alias).
# 64 hex chars; generate with: openssl rand -hex 32
# REQUIRED on staging/prod — without it the backend refuses to boot and the
# platform API cannot encrypt stored SMTP passwords / TOTP MFA secrets.
APP_ENCRYPTION_KEY=

# ─────────────────────────────────────────
# 1. DOMAIN (⭐ REQUIRED)
# ─────────────────────────────────────────
# Legacy single-tenant domain. The SaaS runtime uses SAAS_PRIMARY_DOMAIN.
# Your client's domain. Do NOT include https://
CLIENT_DOMAIN=example.com

# ─────────────────────────────────────────
# 2. REGISTRY + SEED ADMINS (⭐ REQUIRED)
# ─────────────────────────────────────────
# GitHub owner/org whose GHCR holds ecomate-saas-* images
DOCKER_REGISTRY_OWNER=mahmudulhasanriaz
# Better-Auth secret + URL (backend session layer)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# First admin login (used by seed when RUN_SEED=true)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true only on the FIRST deploy to seed initial data
RUN_SEED=false
SEED_DUMMY_DATA=false

# ─────────────────────────────────────────
# 3. SECURITY SECRETS (⭐ REQUIRED — MUST CHANGE)
# ─────────────────────────────────────────
# Generate with: openssl rand -hex 64
# JWT_SECRET and JWT_REFRESH_SECRET MUST be different from each other
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# APP_ENCRYPTION_KEY is declared once, in the SaaS block above (shared by
# the backend and the platform API — same key material, one value).

# Shared secret for internal service-to-service calls (storefront SSR →
# backend). When set (same value on both services), those calls carry an
# x-internal-secret header and are exempt from rate limiting — only from
# private-network addresses. Leave empty to disable the exemption.
INTERNAL_SHARED_SECRET=

# Shared secret for storefront on-demand revalidation (Speed Plan P4).
# When set (same value on backend + storefront), authorized callers can
# POST to the storefront's /api/revalidate to invalidate the `products`
# and `config` fetch cache tags immediately after a mutation. Leave
# empty to keep that endpoint disabled.
REVALIDATION_SECRET=

# Cloudflare edge-cache purge for the admin "Purge all cache" button
# (P0 stale-bundle round, 2026-11-12). The button POSTs purge_everything
# to api.cloudflare.com for THIS tenant's zone(s) only — never another
# client's zone, never a wildcard. Both values are server-side only:
# never put the token in the client bundle, never log it.
# Create the token at dash.cloudflare.com → My Profile → API Tokens →
# Create Token → Custom token with Zone:Cache Purge (or Zone:Zone:Edit)
# permission, scoped to this tenant's zone(s) only. The Zone ID is on
# each zone's Overview page in the dashboard. Leave both empty and the
# button still purges the backend cache + storefront revalidation +
# version bump, and reports the Cloudflare layer as "not configured"
# with this owner-side step. CLOUDFLARE_ZONE_ID accepts a
# comma-separated list when one tenant has several zones.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ─────────────────────────────────────────
# 4. DATABASE (⭐ REQUIRED — change password)
# ─────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ecomate
# Tracking-store retention sweep (PII anonymisation, outbox/snapshot purge).
# Leave empty/true for the default 90d/30d/2y windows; set to false to keep
# raw tracking rows indefinitely.
RETENTION_ENABLED=true

# Backend Node heap ceiling (MB). Node sizes its default heap from the cgroup
# limit, so inside a small container it picked ~256M and startup died with
# "JavaScript heap out of memory" while Prisma loaded the schema. Keep this
# BELOW the backend service's memory limit in docker-compose.yml (2560M).
# Raised to 2048 in Phase 8 (decision D6, measured with k6): the 30-client
# per-tenant cache needs ~0.75-1.2 GB of heap on top of the ~0.7 GB base.
NODE_MAX_OLD_SPACE_SIZE=2048

# ─────────────────────────────────────────
# 5. PORT CONFIGURATION
# ─────────────────────────────────────────
# Change only if another stack already uses these ports on the host
# (multi-client servers). Must match portainer-stack.json defaults.
STOREFRONT_PORT=3000
BACKEND_PORT=4000
ADMIN_PORT=8080
POS_PORT=8081

# ─────────────────────────────────────────
# 6. ADDITIONAL URLS (auto-resolved from CLIENT_DOMAIN)
# ─────────────────────────────────────────
# These are automatically built from CLIENT_DOMAIN in docker-compose.yml.
# Only override if you need a non-standard setup.
CORS_ORIGIN=https://${CLIENT_DOMAIN}
APP_URL=https://${CLIENT_DOMAIN}
STOREFRONT_URL=https://${CLIENT_DOMAIN}
# ─────────────────────────────────────────
# 8. OPTIONAL OVERRIDES (all have working compose defaults)
# ─────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecomate
# API_URL=http://backend:4000/api
# POS_URL=http://pos:80
# ADMIN_VITE_BASE=/admin/
# BACKUP_STORAGE_DIR=/app/backup-storage
# APP_DATA_DIR=/app/app-data
# (Backup timeouts, R2, mobile-builder and pixel vars below all default
# sensibly — see docker-compose.yml and section 7.)
ADMIN_VITE_API_URL=/api
# POS Terminal sidebar link (e.g. https://pos.xyz.com/pos). Leave empty for
# auto-detect (admin.* -> pos.*, localhost -> :5174).
ADMIN_VITE_POS_URL=
STORE_NEXT_PUBLIC_API_URL=https://${CLIENT_DOMAIN}/api
# Runtime read too: the storefront container gets this same value as a
# plain (non-NEXT_PUBLIC_) env var, so it is read at runtime as the env
# fallback for canonicals — the Settings domain wins over it when set.
STORE_NEXT_PUBLIC_STOREFRONT_URL=https://${CLIENT_DOMAIN}

# Observability + alerting (Phase 8; shared by backend + platform-api).
# All have working compose defaults; empty Sentry/alert values disable those features.
LOG_LEVEL=info
SENTRY_DSN=
OPS_ALERT_EMAIL=
OPS_ALERT_MIN_INTERVAL_MS=900000
# Direct SMTP for ops alerts (backend; bypasses the email queue).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_SECURE=false
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_SMTP_FROM=
# BullMQ queue watcher + Bull Board (backend).
QUEUE_WATCHER_ENABLED=true
QUEUE_WATCHER_INTERVAL_MS=60000
QUEUE_DEPTH_ALERT_THRESHOLD=1000
BULL_BOARD_ENABLED=true
# Billing-job failure watcher (platform-api).
JOB_WATCHER_ENABLED=true
JOB_WATCHER_INTERVAL_MS=300000
# TLS/domain health job (platform-api).
TLS_PROBE_ENABLED=true
TLS_PROBE_INTERVAL_MS=3600000
TLS_EXPIRY_ALERT_DAYS=14
TLS_PROBE_PORT=443
TLS_PROBE_TIMEOUT_MS=10000
TLS_PRIMARY_PROBE_ENABLED=

# ─────────────────────────────────────────
# 7. TRACKING PIXELS (Optional)
# ─────────────────────────────────────────
# Can also be configured later from the Admin Panel → Settings → Tracking
META_PIXEL_ID=
META_ACCESS_TOKEN=
TIKTOK_PIXEL_CODE=
TIKTOK_ACCESS_TOKEN=
GA_MEASUREMENT_ID=
GA_API_SECRET=
GA_ADS_CONVERSION_ID=
GA_ADS_CONVERSION_LABEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ADS_CONVERSION_ID=
TENANT_REGISTRY_REFRESH_MS=60000
# Per-tenant Prisma client cache (backend tenancy). 30 cached clients x
# pool max 2 = 60 max tenant connections, inside the 300 Postgres
# max_connections (Phase 8 decision D6, measured with k6 in Stage 2: each
# client costs ~25-40 MB of heap, so 60 cannot fit the heap budget, and 30
# is the measured hard ceiling). Code default is 100 (200 conns).
TENANT_PRISMA_MAX_CLIENTS=30
# Idle eviction for cached per-tenant Prisma clients (ms).
TENANT_PRISMA_IDLE_MS=600000
# Default tenant for context-less backend paths (boot-time providers,
# health, Better Auth, cache purge, queued jobs). REQUIRED in production:
# without it the backend cannot boot — a provider touches Prisma during DI
# with no request tenant context (proven live, 2026-11-17). The default is
# the documented fallback UUID, which targets an empty tenant scope (no
# tenant rows exist under it); request paths always resolve a real tenant
# via middleware. (The code comments call the HARDCODED fallback TEST-ONLY
# because a missing context must fail closed rather than silently target a
# tenant — an explicitly configured value is the intended production
# bridge, and this default points at an empty scope, not a real tenant.)
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000000
DEFAULT_TENANT_SLUG=default
# Directory the platform API falls back to for tenant exports when
# TENANT_EXPORT_DIR is unset (<APP_DATA_DIR>/tenant-exports). Compose sets
# TENANT_EXPORT_DIR explicitly, so this stays unset in the stack.
# APP_DATA_DIR=/app/app-data
